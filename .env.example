# WordPress headless CMS (WPGraphQL endpoint).
# Local development: the LocalWP site "Autonomy-code" must be running.
# Local's router mode "localhost" serves on a port (see the Local app);
# "site domains" mode serves at http://autonomy-code.local/graphql.
# Leave unset to serve everything from the local seed data.
WORDPRESS_API_URL=http://localhost:10024/graphql

# Contact and Speaking forms: sent through the practice mailbox over SMTP.
# Set these in Vercel (Production) and in .env.local for local testing.
SMTP_USER=
SMTP_PASS=
# Optional. Defaults: send.one.com, 465, and SMTP_USER as the inbox.
SMTP_HOST=
SMTP_PORT=
ENQUIRY_TO=

# Newsletter sign-up: adds the address to SendFox.
# Token: SendFox > Settings > API > Personal Access Tokens.
SENDFOX_TOKEN=
# Optional: the number of the list to add people to (from the list's URL).
SENDFOX_LIST_ID=

# Payment notifications: Stripe calls /api/stripe/webhook on each paid
# checkout. Signing secret from Stripe > Developers > Webhooks (whsec_...).
STRIPE_WEBHOOK_SECRET=
